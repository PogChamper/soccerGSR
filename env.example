# Application Settings
DEBUG=true

# Model Configuration
# MODEL_PATH=./models/best.onnx  # Default, auto-downloaded
MODEL_GDRIVE_ID=1OA6l1GEb6ki5Dq2zSmJgH4AcEkbYvisq
MODEL_AUTO_DOWNLOAD=true
MODEL_INPUT_SIZE=1280
