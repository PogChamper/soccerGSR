# Application Settings
DEBUG=false

# Runtime model artifacts are verified by app/utils/models_registry.py.
MODEL_AUTO_DOWNLOAD=true
# OSNet has no automatic source until its release artifact is published. Its
# path override is read from the process environment, not from this file:
#   export MODELS__OSNET_REID__PATH=/absolute/path/osnet_x1_0_soccernet.onnx

# DEIMv2 detector
DEIMV2_CONFIDENCE_THRESHOLD=0.4

# Local job processing
MAX_VIDEO_SIZE_MB=100
MAX_PENDING_JOBS=4
# DATABASE_URL=sqlite+aiosqlite:////absolute/path/soccer_gsr.db
# ARTIFACT_DIR=/absolute/path/soccer_gsr_jobs
