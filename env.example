# Application Settings
DEBUG=true

# Detector backend: "deimv2" (default) or "yolo" (legacy)
DETECTOR_BACKEND=deimv2

# Model Configuration
# All model artifacts are managed by app/utils/models_registry.py
# (Google Drive download + sha256 verification on startup).
MODEL_AUTO_DOWNLOAD=true
# Ad-hoc path override for any registered model, e.g.:
# MODELS__DEIMV2_DETECTOR__PATH=/path/to/custom.onnx

# YOLO detector (legacy backend only)
MODEL_INPUT_SIZE=1280
CONFIDENCE_THRESHOLD=0.25
IOU_THRESHOLD=0.45

# DEIMv2 detector
DEIMV2_INPUT_SIZE=896
DEIMV2_CONFIDENCE_THRESHOLD=0.4
DEIMV2_MODEL_SIZE=m

# Database
DATABASE_URL=sqlite+aiosqlite:///./soccer_gsr.db

# JWT Settings
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Video Processing
MAX_VIDEO_SIZE_MB=100
TEMP_DIR=/tmp/soccer_gsr
